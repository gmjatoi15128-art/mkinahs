{
  "version": 2,
  "buildCommand": "pnpm build:vercel",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "redirects": [
    { "source": "/robots.txt", "destination": "https://mkinstitut-k6f3dinp.manus.space/robots.txt", "permanent": false },
    { "source": "/sitemap.xml", "destination": "https://mkinstitut-k6f3dinp.manus.space/sitemap.xml", "permanent": false }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
